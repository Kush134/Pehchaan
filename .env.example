# Copy to .env at repository root. Keep all credentials server-side.
# Default SQLite fallback needs no database service. PostgreSQL is recommended:
# DATABASE_URL=postgresql+psycopg://pehchaan:pehchaan_local_demo@localhost:5433/pehchaan
DATABASE_URL=sqlite:///./pehchaan.db
# Optional locally; Docker Compose overrides this with redis://redis:6379/0.
REDIS_URL=

# Set your subscription key and restart the API for genuine Sarvam requests.
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_FAST_MODEL=deepseekv4.1-flash-1017
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
# Provider errors are labelled explicitly; unsupported subscription/model access
# is never represented as a successful real request.
DEMO_MODE=true

# Generate once: python3 -c 'import secrets; print(secrets.token_hex(32))'
POLICY_SIGNING_SECRET=
AUTO_SEED=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_BYTES=10485760
API_TIMEOUT_SECONDS=30

# Used only by Docker Compose; change before any nonlocal deployment.
POSTGRES_PASSWORD=pehchaan_local_demo
# Next.js server proxy target. Never set a Sarvam key in NEXT_PUBLIC_*.
API_INTERNAL_URL=http://127.0.0.1:8000

# Outbound offer calls: Twilio carries PSTN + press-1 DTMF; Sarvam provides voice.
# Disabled until calling credentials and a public HTTPS callback URL are ready.
TELEPHONY_ENABLED=false
TELEPHONY_PROVIDER=twilio
TELEPHONY_DEMO_PHONE=
TELEPHONY_DEMO_CUSTOMER_NAME=Kush
TELEPHONY_DEMO_CUSTOMER_TOKEN=PK-0036
TELEPHONY_PUBLIC_BASE_URL=
# Generate a separate persistent secret: python3 -c 'import secrets; print(secrets.token_hex(32))'
TELEPHONY_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional preferred REST credentials. Keep Auth Token above for webhook signing.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=

# Optional native Sarvam Voice Agents adapter (call outcomes, without keypad input).
# Speech API keys are not Voice Agents workspace keys.
SARVAM_VOICE_API_KEY=
SARVAM_VOICE_ORG_ID=
SARVAM_VOICE_WORKSPACE_ID=
SARVAM_VOICE_APP_ID=
SARVAM_VOICE_APP_VERSION=1
SARVAM_VOICE_CONNECTION_ID=
SARVAM_VOICE_AGENT_PHONE=

# Offer notifications use SMS. Trial accounts cannot send custom offer text.
NOTIFICATION_CHANNEL=sms
SMS_ENABLED=false
TWILIO_SMS_TRIAL=true
TWILIO_SMS_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
